# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# Load custom fzf configuration
[[ -f ~/.config/zsh/fzf.zsh ]] && source ~/.config/zsh/fzf.zsh

# Quick edit aliases
alias dot='cd ~/dotfiles'
alias conf-tmux='vim ~/dotfiles/tmux/tmux.conf'
alias conf-zsh='vim ~/dotfiles/zsh/.zshrc'
alias conf-fzf='vim ~/dotfiles/zsh/fzf.zsh'

# Quick reload aliases
alias reload-zsh='source ~/.zshrc && echo "Zsh reloaded."'
alias reload-tmux='tmux source-file ~/.config/tmux/tmux.conf && echo "Tmux reloaded."'

# Added by Antigravity
export PATH="/Users/sdurgbuns/.antigravity/antigravity/bin:$PATH"

# adding fzf-git
[[ -f ~/code/my-playground/dotfiles/zsh/fzf-git.sh ]] && source ~/code/my-playground/dotfiles/zsh/fzf-git.sh

# 1. Prevent virtualenv from changing the prompt automatically (Must be set early)
export VIRTUAL_ENV_DISABLE_PROMPT=1

# 2. Enable Zsh's version control info system (for Git)
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '%F{green}(%b)%f '
zstyle ':vcs_info:git:*' actionformats '%F{green}(%b|%a)%f '

# 3. Enable parameter expansion in the prompt
setopt PROMPT_SUBST

# 4. Create a function to dynamically check for Python/Conda environments
get_env_name() {
    if [[ -n "$CONDA_DEFAULT_ENV" ]]; then
        echo "%F{yellow}($CONDA_DEFAULT_ENV)%f "
    elif [[ -n "$VIRTUAL_ENV" ]]; then
        echo "%F{yellow}($(basename "$VIRTUAL_ENV"))%f "
    else
        echo ""
    fi
}

# 5. Define your clean custom prompt
_CACHED_HOSTNAME=$(scutil --get ComputerName)
PROMPT='$(get_env_name)[%n@${_CACHED_HOSTNAME}] %F{red}%1~%f %% ${vcs_info_msg_0_}'

# 6. Pyenv settings
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Additional PATH
export PATH="$HOME/.local/bin:$PATH"

# Aliases
alias ll='eza -la --git'
alias ls='eza'
alias grep='rg'
alias lg='lazygit'


# Google Cloud SDK
if [ -f '/Users/sdurgbun/installer-files/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/sdurgbun/installer-files/google-cloud-sdk/path.zsh.inc'; fi
if [ -f '/Users/sdurgbun/installer-files/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/sdurgbun/installer-files/google-cloud-sdk/completion.zsh.inc'; fi

# Claude Code Vertex AI settings
export CLAUDE_CODE_USE_VERTEX=1
export CLOUD_ML_REGION=global
export ANTHROPIC_VERTEX_PROJECT_ID=itpc-gcp-core-pe-eng-claude

